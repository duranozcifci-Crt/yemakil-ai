<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        CepAkıl'ın İLK izni.
        Android 11 ve sonrasında telefondaki uygulamaları listelemek için gerekir.
        Yükleme sırasında verilir; kullanıcıya ayrıca sorulmaz. Yalnız uygulama adları,
        sürümleri, yükleyen mağaza ve istedikleri izinler okunur.
        Bilerek İSTENMEYENLER: depolama, SMS, kişiler, arama kayıtları, konum, mikrofon,
        kamera, erişilebilirlik, cihaz yöneticisi. (Derleme sistemi bunları denetler.)
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        "Tamamen kaldır" düğmesinin Android'in kaldırma onay penceresini açabilmesi için.
        Yükleme sırasında verilir. Bu izinle hiçbir uygulama sessizce silinemez:
        Android her kaldırmada kullanıcıya ayrıca sorar.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Wi-Fi kontrolü: bağlı ağın şifreleme türünü (şifresiz / WEP / WPA) okumak için.
        İkisi de yükleme sırasında verilir; internet erişimi SAĞLAMAZ, ağ adı ya da konum okunmaz.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
        İnternet: YALNIZ herkese açık tehdit listelerini (USOM, OpenPhish, URLhaus)
        indirmek ve web korumasında DNS sorularını telefonun kendi DNS sunucusuna iletmek için.
        Kullanıcının hiçbir verisi (dosya, mesaj, uygulama listesi, açtığı siteler) gönderilmez.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Anlık koruma ve mesaj uyarıları için (Android 13+ açıkça sorulur). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/veri_aktarim_kurallari"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CepAkil"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CepAkil.Acilis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Başka uygulamadan "Paylaş > CepAkıl" ile bağlantı kontrolü -->
            <intent-filter android:label="@string/paylas_etiketi">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Web koruması: yalnız DNS sorularını denetleyen yerel VPN (kullanıcı açar). -->
        <service
            android:name=".koruma.CepAkilVpn"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <receiver android:name=".koruma.IzinVerAlici" android:exported="false" />
    </application>
</manifest>
